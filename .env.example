# ══════════════════════════════════════
# VARIABLES DE ENTORNO — Constructora
# Copiar este archivo como .env y rellenar
# ══════════════════════════════════════

# ── Supabase ──
# Obtener en https://supabase.com → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Cloudflare R2 (imágenes) ──
# Crear en https://dash.cloudflare.com → R2
# Obtener credenciales en: R2 → Manage R2 API Tokens

# URL pública del bucket (con dominio custom o .r2.dev)
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Endpoint S3 (reemplazar ACCOUNT_ID con tu ID de cuenta)
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# Credenciales de API Token (crear en R2 → Manage R2 API Tokens)
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nombre del bucket
R2_BUCKET_NAME=constructora-images

# ── Resend (emails) ──
# Obtener gratis en https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remitente del formulario. Debe ser de un dominio VERIFICADO en Resend
# (resend.com → Domains). Sin dominio propio usar onboarding@resend.dev:
# en ese caso Resend solo entrega al correo con el que se creó la cuenta.
RESEND_FROM=Formulario Web <onboarding@resend.dev>

# ── Email destino del formulario ──
CONTACT_EMAIL=inmobiliariayconstructoraryj@gmail.com

# ── URL del sitio (para SEO/og:image) ──
SITE_URL=https://constructora.cl
